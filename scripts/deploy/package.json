{
  "name": "@serverless-blog/deploy",
  "version": "1.0.0",
  "type": "module",
  "description": "Atomic deployment scripts for Serverless Blog",
  "private": true,
  "scripts": {
    "deploy": "tsx cli.ts",
    "deploy:dry-run": "tsx cli.ts --dry-run",
    "astro-deploy": "tsx astroLocalDeployCli.ts",
    "astro-deploy:dry-run": "tsx astroLocalDeployCli.ts --dry-run",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "3.1128.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "3.1128.0",
    "@aws-sdk/client-s3": "3.1128.0",
    "@aws-sdk/signature-v4a": "3.1111.0",
    "commander": "^13.1.0",
    "mime-types": "^2.1.35"
  },
  "overrides": {
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.5.7"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
