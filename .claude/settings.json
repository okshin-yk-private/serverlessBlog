{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run format:check:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bun run test:unit:*)",
      "Bash(bun run test:go:*)",
      "Bash(bun run verify:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "WebSearch",
      "mcp__aws-mcp__aws___search_documentation",
      "mcp__aws-mcp__aws___read_documentation",
      "mcp__sequential-thinking__sequentialthinking"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh"
          }
        ]
      }
    ]
  }
}
