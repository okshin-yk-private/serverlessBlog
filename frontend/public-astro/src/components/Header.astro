---
/**
 * Header.astro - Site Header Component
 *
 * Navigation header with logo, site title, and navigation links.
 * Features:
 * - Sticky header with blur effect
 * - Theme-aware brand wordmark
 * - Navigation: Articles, About, Admin, Theme toggle
 * - Responsive design
 */

import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="header-container">
    <a href="/" class="site-logo" aria-label="bone of my fallacy - Home">
      <img src="/logo-light.png" alt="bone of my fallacy" class="logo-image logo-image-light" />
      <img src="/logo-dark.png" alt="" class="logo-image logo-image-dark" aria-hidden="true" />
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" class="nav-link">Articles</a>
      <a href="/about" class="nav-link">About</a>
      <ThemeToggle />
      <a href="/admin/" class="admin-icon-link" title="Admin" aria-label="Admin">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="admin-icon-svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
          ></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 88px;
  }

  .site-logo {
    text-decoration: none;
    display: block;
    align-items: center;
    line-height: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .site-logo:hover {
    opacity: 0.82;
    transform: translateY(-1px);
  }

  .logo-image {
    display: block;
    height: 58px;
    width: auto;
    max-width: 230px;
    object-fit: contain;
  }

  .logo-image-dark {
    display: none;
  }

  .logo-image-light {
    mix-blend-mode: multiply;
  }

  :global(:root[data-theme='dark']) .logo-image-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .logo-image-dark {
    display: block;
  }

  .site-nav {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .nav-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s ease, background 0.2s ease;
    padding: 10px 14px;
    border-radius: 999px;
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-text-heading);
    background: var(--color-primary-soft);
  }

  .admin-icon-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid transparent;
  }

  .admin-icon-link:hover {
    color: var(--color-accent);
    border-color: var(--color-border);
    background: var(--color-surface);
  }

  .admin-icon-svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 768px) {
    .header-container {
      height: 72px;
      padding: 0 20px;
    }

    .logo-image {
      height: 46px;
      max-width: 178px;
    }

    .site-nav {
      gap: 2px;
    }

    .nav-link {
      font-size: 0.68rem;
      padding: 8px 9px;
    }

    .admin-icon-link {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .logo-image {
      height: 40px;
      max-width: 145px;
    }

    .nav-link {
      padding-inline: 6px;
    }
  }
</style>
