---
import type { Post } from '../lib/api';
import { generateExcerpt, getPostPathSegment } from '../lib/postUtils';

interface Props {
  post: Post;
  variant?: 'record' | 'feature' | 'aside';
}

const { post, variant = 'record' } = Astro.props;
const excerpt = generateExcerpt(
  post.excerpt || post.contentHtml,
  variant === 'feature' ? 120 : variant === 'aside' ? 80 : 100
);
const date = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Tokyo',
})
  .format(new Date(post.createdAt))
  .replaceAll('/', '.');
const postHref = `/posts/${getPostPathSegment(post)}/`;
const Heading =
  variant === 'feature' ? 'h1' : variant === 'aside' ? 'h2' : 'h3';
---

<article
  class:list={[
    'post-card',
    `post-${variant}`,
    { 'long-title': post.title.length > 42 },
  ]}
  data-testid={variant === 'record' ? 'article-card' : `${variant}-article`}
  data-post-id={variant === 'record' ? post.id : undefined}
>
  <div class="post-meta">
    <time datetime={post.createdAt}>{date}</time>
    <span class="category" data-testid="article-category">{post.category}</span>
  </div>
  <div class="post-body">
    <Heading class="post-title" data-testid="article-title"
      ><a href={postHref}>{post.title}</a></Heading
    >
    <p class="excerpt" data-testid="article-excerpt">{excerpt}</p>
    {
      variant === 'record' && post.tags?.length > 0 && (
        <ul class="tags" aria-label="タグ">
          {post.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    {
      variant !== 'record' && (
        <a class="read-link" href={postHref} aria-label={`${post.title}を読む`}>
          記事を読む <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .post-card {
    min-width: 0;
  }
  .post-card[hidden] {
    display: none;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    line-height: 1.8;
    color: var(--color-text);
  }
  .category {
    color: var(--color-primary);
    font-weight: 500;
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
  }
  .post-title {
    margin: 0 0 12px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .post-title a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.18em;
  }
  .post-title a:hover {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .excerpt {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.95;
    overflow-wrap: anywhere;
  }
  .read-link {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    min-height: 44px;
    margin-top: 16px;
    font-family: var(--font-display);
    color: var(--color-link);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }
  .read-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .post-feature .post-meta {
    margin-bottom: 20px;
  }
  .post-feature .category {
    order: -1;
  }
  .post-feature .post-title {
    font-size: clamp(2.5rem, 5.1vw, 4.25rem);
    line-height: 1.3;
    margin-bottom: 26px;
    text-wrap: balance;
  }
  .post-feature.long-title .post-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
  }
  .post-feature .excerpt {
    font-size: 1.15rem;
    max-width: 42em;
  }
  .post-aside .post-meta {
    margin-bottom: 16px;
    font-size: 0.75rem;
  }
  .post-aside .post-title {
    font-size: clamp(1.3rem, 2vw, 1.75rem);
  }
  .post-aside .excerpt {
    font-size: 0.95rem;
  }
  .post-record {
    display: grid;
    grid-template-columns: 145px minmax(0, 1fr);
    gap: 32px;
    padding: 26px 0;
    border-top: 1px solid var(--color-border);
  }
  .post-record .post-meta {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding-top: 4px;
  }
  .post-record .post-title {
    font-size: 1.35rem;
    margin-bottom: 6px;
  }
  .post-record .excerpt {
    font-size: 0.95rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }
  .tags li::before {
    content: '#';
    margin-right: 2px;
  }
  @media (max-width: 767px) {
    .post-feature .post-title {
      font-size: clamp(2.1rem, 8.5vw, 3.5rem);
    }
    .post-feature.long-title .post-title {
      font-size: clamp(1.75rem, 6.5vw, 2.5rem);
    }
    .post-feature .excerpt {
      font-size: 1.05rem;
    }
    .post-record {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }
    .post-record .post-meta {
      flex-direction: row;
      gap: 8px 16px;
      padding: 0;
    }
    .post-record .post-title {
      font-size: 1.2rem;
    }
  }
</style>
