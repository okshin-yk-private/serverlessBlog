---
/**
 * PostCard.astro - 記事カードコンポーネント
 *
 * Requirements:
 * - 2.2: 記事一覧ページ用のカードコンポーネント
 *   - タイトル、カテゴリ、作成日時、抜粋を表示
 *   - 記事詳細へのリンクを設定
 */

import type { Post } from '../lib/api';
import { generateExcerpt, formatDateJa } from '../lib/postUtils';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const excerpt = generateExcerpt(post.contentHtml, 100);
const formattedDate = formatDateJa(post.createdAt);

// PR7: prefer slug-based URL when the post has one; fall back to id for
// any post that hasn't been backfilled yet.
const postHref = post.slug ? `/posts/${post.slug}/` : `/posts/${post.id}/`;
---

<article class="post-card" data-testid="article-card" data-post-id={post.id}>
  <a href={postHref} class="post-link">
    <h2 class="post-title" data-testid="article-title">{post.title}</h2>
    <div class="post-meta">
      <span class="category" data-testid="article-category">{post.category}</span>
      <span class="date">{formattedDate}</span>
    </div>
    {post.tags && post.tags.length > 0 && (
      <div class="tags">
        {post.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
    <p class="excerpt" data-testid="article-excerpt">{excerpt}</p>
  </a>
</article>

<style>
  .post-card {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 32px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    height: 100%;
  }

  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 32px;
    width: 44px;
    height: 3px;
    background: var(--color-accent);
    border-radius: 0 0 999px 999px;
    transition: width 0.25s ease;
  }

  .post-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card-strong);
    border-color: var(--color-border-strong);
  }

  .post-card:hover::before {
    width: 72px;
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .post-title {
    margin: 8px 0 20px;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.6vw, 1.55rem);
    font-weight: 600;
    color: var(--color-text-heading);
    letter-spacing: -0.035em;
    line-height: 1.35;
    transition: color 0.2s ease;
  }

  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 18px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .category {
    background: var(--color-primary-soft);
    padding: 5px 12px;
    border-radius: 999px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .date {
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .tag {
    background: transparent;
    padding: 3px 9px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-weight: 500;
    border: 1px solid var(--color-border);
  }

  .excerpt {
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.85;
    flex-grow: 1;
    margin: 0;
  }

  @media (max-width: 768px) {
    .post-card {
      padding: 28px;
      border-radius: 20px;
    }

    .post-card::before {
      left: 28px;
    }
  }
</style>
