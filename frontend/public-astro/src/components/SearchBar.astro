---
import type { SearchablePost } from '../lib/searchUtils';
interface Props {
  posts: SearchablePost[];
  asOfDay?: string;
}
const { posts, asOfDay } = Astro.props;
const categories = [...new Set(posts.map((post) => post.category))].filter(
  Boolean
);
// Escape '<' so article metadata cannot end the inline JSON script element.
const searchData = JSON.stringify(posts).replace(/</g, '\\u003c');
---

<div
  id="archive-search"
  data-testid="search-container"
  data-empty={posts.length === 0 ? 'true' : undefined}
>
  <div class="archive-toolbar">
    <h2 id="archive-title" class="sr-only">記事一覧</h2>
    <div
      class="search-input-wrapper"
      data-search-control
      hidden={posts.length === 0}
    >
      <label class="sr-only" for="search-input"
        >タイトル・カテゴリー・タグで記事を検索</label
      >
      <svg
        class="search-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
        ><path
          fill-rule="evenodd"
          d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
          clip-rule="evenodd"></path></svg
      >
      <input
        type="search"
        id="search-input"
        placeholder="タイトル・カテゴリー・タグで検索"
        data-testid="search-input"
        aria-controls="article-records"
        autocomplete="off"
      />
      <button
        type="button"
        id="search-clear"
        aria-label="検索をクリア"
        data-testid="search-clear"
        hidden>×</button
      >
    </div>
    <label class="date-filter" data-search-control hidden={posts.length === 0}
      >公開日
      <input
        type="date"
        id="publication-date"
        aria-controls="article-records"
        max={asOfDay}
        min="1000-01-01"
      />
    </label>
  </div>
  <div class="search-summary">
    <p id="search-status" role="status" aria-live="polite" aria-atomic="true">
      {posts.length}件の記事
    </p>
    <button
      id="date-clear"
      type="button"
      hidden
      aria-label="公開日の絞り込みを解除"></button>
    <button id="filters-clear" type="button" hidden>すべての条件を解除</button>
  </div>
  {
    categories.length > 1 && (
      <div
        class="category-filters"
        role="group"
        aria-label="カテゴリーで絞り込み"
        data-search-control
        hidden={posts.length === 0}
      >
        <button
          type="button"
          data-category=""
          aria-pressed="true"
          aria-controls="article-records"
        >
          すべて
        </button>
        {categories.map((category) => (
          <button
            type="button"
            data-category={category}
            aria-pressed="false"
            aria-controls="article-records"
          >
            {category}
          </button>
        ))}
      </div>
    )
  }
  <p
    id="no-results-message"
    class="no-results-message"
    data-testid="no-results-message"
    hidden
  >
    検索結果がありません
  </p>
  <script
    is:inline
    id="search-data"
    type="application/json"
    set:html={searchData}
  />
</div>

<script>
  import { initArchiveSearch } from '../lib/archiveSearch';
  const controls = document.getElementById('archive-search');
  const records = document.getElementById('article-records');
  if (controls && records) initArchiveSearch(controls, records);
</script>

<style>
  [hidden] {
    display: none !important;
  }
  #archive-search:not([data-ready]) [data-search-control] {
    visibility: hidden;
  }
  .archive-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 18px;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .search-input-wrapper {
    position: relative;
    flex: 1;
    min-width: 0;
  }
  .search-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    align-items: center;
    font-family: var(--font-display);
    font-size: 0.85rem;
    margin: 12px 0;
  }
  .search-summary p {
    margin: 0;
  }
  .search-summary button {
    min-height: 44px;
    background: transparent;
    color: var(--color-primary);
    border: 0;
    text-decoration: underline;
    cursor: pointer;
    font: inherit;
    padding: 4px;
  }
  .date-filter {
    display: flex;
    gap: 12px;
    align-items: center;
    font: 0.85rem var(--font-display);
    min-width: 0;
  }
  .date-filter input {
    min-width: 0;
    width: 160px;
    padding: 10px;
  }
  .search-icon {
    position: absolute;
    left: 14px;
    top: 14px;
    width: 18px;
    height: 18px;
    color: var(--color-text);
    pointer-events: none;
  }
  input {
    width: 100%;
    min-height: 46px;
    padding: 10px 44px;
    border: 1px solid var(--color-border-strong);
    border-radius: 5px;
    background: var(--color-surface);
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: 1rem;
  }
  input::placeholder {
    color: var(--color-text);
  }
  input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  #search-clear {
    position: absolute;
    right: 1px;
    top: 1px;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-size: 1.5rem;
    cursor: pointer;
  }
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin-bottom: 10px;
  }
  .category-filters button {
    min-height: 44px;
    max-width: 100%;
    padding: 8px 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 0.9rem;
    cursor: pointer;
    overflow-wrap: anywhere;
    text-align: left;
  }
  .category-filters button[aria-pressed='true'] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    font-weight: 500;
  }
  .category-filters button:hover {
    color: var(--color-text-heading);
  }
  .no-results-message {
    padding: 36px 0;
    margin: 0;
    color: var(--color-text);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 767px) {
    .archive-toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    .search-input-wrapper {
      width: 100%;
    }
    .category-filters {
      gap: 4px 20px;
    }
  }
</style>
