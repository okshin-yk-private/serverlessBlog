---
/**
 * Layout.astro - 共通レイアウトコンポーネント
 *
 * Requirements:
 * - 14.1, 14.2: 日本語対応 (<html lang="ja">)
 * - 1.6: 静的HTML生成の基盤
 * - 3.1-3.7: SEOメタタグ対応
 * - 4.1-4.4: JSON-LD構造化データ対応
 */

import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import type { JsonLdPost } from '../lib/jsonLdUtils';

interface Props {
  /** Page title */
  title: string;
  /** Meta description (defaults to site description) */
  description?: string;
  /** Canonical URL for the page */
  canonicalUrl?: string;
  /** Open Graph type (website or article) */
  type?: 'website' | 'article';
  /** OG/Twitter image URL */
  imageUrl?: string;
  /** Article published date (ISO 8601) */
  publishedAt?: string;
  /** Article modified date (ISO 8601) */
  modifiedAt?: string;
  /** Whether to add noindex directive */
  noindex?: boolean;
  /** JSON-LD post data (for article pages) */
  jsonLdPost?: JsonLdPost;
  /** Show WebSite JSON-LD (for home page) */
  showWebSiteJsonLd?: boolean;
}

const SITE_NAME = 'bone of my fallacy';
const DEFAULT_DESCRIPTION = 'プログラミング、テクノロジー、ライフスタイルについてのブログ';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonicalUrl = Astro.url.href,
  type = 'website',
  imageUrl,
  publishedAt,
  modifiedAt,
  noindex = false,
  jsonLdPost,
  showWebSiteJsonLd = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Theme bootstrap (FOUC prevention).
         Reads localStorage.theme ("light" | "dark" | "system"), falls back to system preference,
         and applies data-theme to <html> before any styles render. Must be inline & blocking. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved !== 'light' && saved !== 'dark' && saved !== 'system') {
            saved = 'system';
          }
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var resolved = saved === 'system' ? (prefersDark ? 'dark' : 'light') : saved;
          document.documentElement.setAttribute('data-theme', resolved);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <!-- Theme-aware favicon -->
    <link id="site-favicon" rel="icon" type="image/png" href="/favicon-light.png" />
    <script is:inline>
      (function () {
        var favicon = document.getElementById('site-favicon');
        if (!favicon) return;

        var syncFavicon = function () {
          var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          favicon.setAttribute('href', isDark ? '/favicon-dark.png' : '/favicon-light.png');
        };

        syncFavicon();
        new MutationObserver(syncFavicon).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })();
    </script>

    <!-- SEO Meta Tags (Task 3.1) -->
    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      type={type}
      imageUrl={imageUrl}
      publishedAt={publishedAt}
      modifiedAt={modifiedAt}
      noindex={noindex}
      siteName={SITE_NAME}
    />

    <!-- JSON-LD Structured Data (Task 3.2) -->
    {jsonLdPost && (
      <JsonLd type="BlogPosting" post={jsonLdPost} />
    )}
    {showWebSiteJsonLd && (
      <JsonLd type="WebSite" siteName={SITE_NAME} siteDescription={description} />
    )}

    <!-- Global Styles -->
    <style>
      @import '../styles/global.css';
      @import '../../../shared-ui/src/article.css';
    </style>
  </head>
  <body class="min-h-screen">
    <Header />
    <div class="site-content">
      <slot />
    </div>
    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-seed" aria-hidden="true"></span>
        <p>bone of my fallacy</p>
        <p class="footer-copy">&copy; {new Date().getFullYear()}</p>
      </div>
    </footer>

    <!-- Live OS theme follow when user has not explicitly chosen light/dark. -->
    <script is:inline>
      (function () {
        var mql = window.matchMedia('(prefers-color-scheme: dark)');
        var handler = function (e) {
          var saved = localStorage.getItem('theme') || 'system';
          if (saved !== 'system') return;
          document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        };
        mql.addEventListener('change', handler);
      })();
    </script>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }

  .footer-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 38px 40px;
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: lowercase;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-seed {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 70% 0 70% 0;
    transform: rotate(45deg);
  }

  .footer-copy {
    margin-left: auto !important;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding: 28px 20px;
    }
  }
</style>
