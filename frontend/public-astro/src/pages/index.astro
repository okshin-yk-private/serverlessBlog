---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import SiteIntro from '../components/SiteIntro.astro';
import { getCollection } from 'astro:content';
import { publishedPosts } from '../lib/publicationCalendar';
const asOf = new Date().toISOString();
const posts = publishedPosts(
  (await getCollection('posts')).map((entry) => entry.data),
  asOf
);
const [latest] = posts;
---

<Layout
  title="bone of my fallacy"
  description="テクノロジー、日々の考え、暮らしの記録。bone of my fallacyの個人ブログ。"
  showWebSiteJsonLd={true}
>
  <main class="home-journal" id="main-content">
    <h1 class="sr-only">bone of my fallacy</h1>
    <p class="site-tagline">I am the bone of my fallacy</p>
    <div class="home-section-heading">
      <p>Latest</p><a href="/articles/" data-astro-prefetch="hover"
        >All articles <span aria-hidden="true">→</span></a
      >
    </div>
    <div class="home-grid">
      <section aria-label="最新の記事" data-testid="article-list">
        {
          latest ? (
            <PostCard post={latest} variant="feature" asOf={asOf} />
          ) : (
            <p class="empty-home" data-testid="no-articles">
              記事がありません
            </p>
          )
        }
      </section>
      <SiteIntro />
    </div>
  </main>
</Layout>
<style>
  .home-journal {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }
  .site-tagline {
    font-size: 1.15rem;
    margin: 40px 0 56px;
  }
  .home-section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 24px;
    margin-bottom: 36px;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
  }
  .home-section-heading p {
    font-weight: 700;
    font-size: 1.4rem;
    margin: 0;
  }
  .home-section-heading a {
    color: var(--color-primary);
    font-size: 0.85rem;
    text-underline-offset: 5px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    gap: 48px;
  }
  .empty-home {
    padding: 40px 0;
  }
  @media (max-width: 767px) {
    .home-journal {
      padding: 0 20px 48px;
    }
    .site-tagline {
      font-size: 0.95rem;
      margin: 26px 0 34px;
    }
    .home-section-heading {
      flex-wrap: wrap;
      padding-bottom: 14px;
      margin-bottom: 26px;
      gap: 4px 16px;
    }
    .home-section-heading p {
      font-size: 1.2rem;
    }
    .home-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
