---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { fetchAllPosts, type Post } from '../lib/api';
import { sortPostsByDate } from '../lib/postUtils';

let posts: Post[] = [];
let error: string | null = null;
try {
  posts = sortPostsByDate(await fetchAllPosts());
} catch (e) {
  console.error('Failed to fetch posts:', e);
  error = e instanceof Error ? e.message : 'Unknown error';
}
const [featuredPost, nextPost] = posts;
const searchablePosts = posts.map(({ id, title, category, tags }) => ({
  id,
  title,
  category,
  tags: tags || [],
}));
---

<Layout
  title="bone of my fallacy"
  description="最新のブログ記事一覧。テクノロジー、ライフスタイル、プログラミングなど様々なトピックを扱っています。"
  showWebSiteJsonLd={true}
>
  <main class="journal container" id="main-content">
    <p class="site-tagline">I am the bone of my fallacy</p>
    {
      featuredPost ? (
        <>
          <section
            class:list={['hero-section', { 'single-feature': !nextPost }]}
            aria-label="最近の記事"
          >
            <PostCard post={featuredPost} variant="feature" />
            {nextPost && (
              <aside class="next-story" aria-label="あわせて読む">
                <p class="section-eyebrow">あわせて読む</p>
                <PostCard post={nextPost} variant="aside" />
              </aside>
            )}
          </section>
          <section class="archive" aria-labelledby="archive-title">
            <SearchBar posts={searchablePosts} />
            <div
              id="article-records"
              class="post-list-container"
              data-testid="article-list"
            >
              {posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          </section>
        </>
      ) : (
        <section class="empty-journal" aria-labelledby="empty-title">
          <p class="section-eyebrow">
            Thoughts, technology &amp; everyday life
          </p>
          <h1 id="empty-title">これまでの記録</h1>
          {error ? (
            <div class="error-message" role="alert">
              <p>記事の取得に失敗しました: {error}</p>
            </div>
          ) : (
            <p class="no-articles" data-testid="no-articles">
              記事がありません
            </p>
          )}
        </section>
      )
    }
  </main>
</Layout>

<style>
  .journal {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px 96px;
  }
  .site-tagline {
    margin: 20px 0 50px;
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .hero-section {
    display: grid;
    grid-template-columns: minmax(0, 2.3fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: 60px;
  }
  .hero-section.single-feature {
    grid-template-columns: minmax(0, 850px);
  }
  .next-story {
    border-left: 1px solid var(--color-border);
    padding-left: 32px;
    min-width: 0;
  }
  .section-eyebrow {
    margin: 0 0 32px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-heading);
  }
  .archive {
    border-top: 1px solid var(--color-border);
    padding-top: 36px;
    scroll-margin-top: 100px;
  }
  .post-list-container {
    border-bottom: 1px solid var(--color-border);
  }
  .empty-journal {
    padding: 42px 0 110px;
  }
  .empty-journal h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }
  .no-articles {
    margin-top: 32px;
    color: var(--color-text);
  }
  .error-message {
    background: var(--color-danger-bg);
    border: 1px solid var(--color-danger-border);
    border-radius: 6px;
    padding: 16px;
    color: var(--color-danger-text);
    overflow-wrap: anywhere;
  }
  @media (max-width: 767px) {
    .journal {
      padding: 0 20px 64px;
    }
    .site-tagline {
      margin: 18px 0 36px;
      font-size: 0.8rem;
    }
    .hero-section {
      grid-template-columns: 1fr;
      padding-bottom: 36px;
      gap: 30px;
    }
    .next-story {
      border-left: 0;
      border-top: 1px solid var(--color-border);
      padding: 24px 0 0;
    }
    .section-eyebrow {
      margin-bottom: 18px;
    }
    .archive {
      padding-top: 28px;
    }
  }
</style>
