---
/**
 * 404.astro - Branded custom error page.
 *
 * Requirements:
 * - 15.1: Generate a custom 404 page
 * - 15.2: Include navigation back to home
 * - 15.4: Add a noindex directive
 * - 15.5: Keep the shared site header and navigation
 */
import Layout from '../layouts/Layout.astro';
import { get404PageContent } from '../lib/staticPageUtils';

const notFoundContent = get404PageContent();
---

<Layout
  title={notFoundContent.title}
  description={notFoundContent.message}
  noindex={true}
>
  <main class="error-container">
    <div class="error-content">
      <div class="seedling" aria-hidden="true">
        <span class="stem"></span>
        <span class="leaf leaf-left"></span>
        <span class="leaf leaf-right"></span>
      </div>
      <p class="error-label">Page not found</p>
      <h1 class="error-code">404</h1>
      <h2 class="error-title">ページが見つかりません</h2>
      <p class="error-message">{notFoundContent.message}</p>

      <a href={notFoundContent.homeLink} class="home-button">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="M12 19l-7-7 7-7"></path>
        </svg>
        {notFoundContent.homeButtonText}
      </a>

      <div class="suggestions">
        <p class="suggestions-title">こちらもお試しください</p>
        <ul class="suggestions-list">
          {notFoundContent.suggestions.map((suggestion) => (
            <li>
              <a href={suggestion.link} class="suggestion-link">{suggestion.text}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-container {
    min-height: calc(100vh - 170px);
    padding: 92px 20px 112px;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .error-content {
    width: min(100%, 620px);
  }

  .seedling {
    position: relative;
    width: 54px;
    height: 54px;
    margin: 0 auto 26px;
  }

  .stem {
    position: absolute;
    left: 26px;
    bottom: 2px;
    width: 3px;
    height: 34px;
    background: var(--color-accent);
    border-radius: 999px;
  }

  .leaf {
    position: absolute;
    width: 24px;
    height: 17px;
    background: var(--color-accent-bright);
  }

  .leaf-left {
    left: 5px;
    top: 17px;
    border-radius: 90% 12% 90% 12%;
    transform: rotate(18deg);
  }

  .leaf-right {
    right: 5px;
    top: 8px;
    border-radius: 12% 90% 12% 90%;
    transform: rotate(-18deg);
  }

  .error-label {
    margin: 0 0 12px;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .error-code {
    margin: 0;
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 19vw, 10rem);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 0.95;
  }

  .error-title {
    margin: 32px 0 12px;
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 4vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .error-message {
    max-width: 480px;
    margin: 0 auto 34px;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .home-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 24px;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .home-button:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
  }

  .suggestions {
    margin-top: 64px;
    padding-top: 26px;
    border-top: 1px solid var(--color-border);
  }

  .suggestions-title {
    margin: 0 0 16px;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .suggestions-list {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .suggestion-link {
    color: var(--color-text);
    font-size: 0.86rem;
    text-underline-offset: 5px;
  }

  .suggestion-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 560px) {
    .error-container {
      padding-top: 64px;
    }

    .suggestions-list {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
