---
/**
 * [slug].astro - 記事詳細ページ (PR7: friendly slug ルーティング)
 *
 * `/posts/<slug>/index.html` として静的生成する。slug を持たない記事は
 * `/posts/<id>/index.html` にフォールバックする。
 * SEO の canonical は生成された URL をそのまま採用する。
 */
import Layout from '../../layouts/Layout.astro';
import { fetchAllPosts, type Post } from '../../lib/api';
import {
  generateDescription,
  formatPublishedDate,
  getFirstImage,
  getPostImageUrls,
} from '../../lib/postDetailUtils';
import type { JsonLdPost } from '../../lib/jsonLdUtils';
import { getPostPathSegment } from '../../lib/postUtils';

/**
 * getStaticPaths: 全公開記事のパスを生成する。
 *
 * slug は任意項目なので、持たない記事は id をパスに使う。PostCard が
 * `post.slug ?? post.id` でリンクを組み立てるため、ここで同じ規則を使わないと
 * slug の無い記事のリンク先が生成されず、S3 が AccessDenied を返す。
 * (以前は [id].astro が id ベースの配信を担っていたが、そのファイルは削除済み。)
 */
export async function getStaticPaths() {
  const posts = await fetchAllPosts();

  return posts.map((post) => ({
    params: { slug: getPostPathSegment(post) },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const description = generateDescription(post.contentHtml);
const publishedDate = formatPublishedDate(post);
const firstImage = getFirstImage(post.imageUrls);
const images = getPostImageUrls(post);

// SEO: publishedAt or createdAt for article meta
const articlePublishedAt = post.publishedAt ?? post.createdAt;
const articleModifiedAt = post.updatedAt;

// JSON-LD: BlogPosting structured data (Task 3.2)
const jsonLdPost: JsonLdPost = {
  id: post.id,
  slug: post.slug,
  title: post.title,
  description: description,
  publishedAt: articlePublishedAt,
  updatedAt: articleModifiedAt,
  authorName: post.authorId || 'Anonymous',
  imageUrl: firstImage,
};

---

<Layout
  title={post.title}
  description={description}
  type="article"
  imageUrl={firstImage}
  publishedAt={articlePublishedAt}
  modifiedAt={articleModifiedAt}
  jsonLdPost={jsonLdPost}
>
  <article class="post-detail">
    <header class="post-header">
      <div class="post-meta">
        <span class="category" data-testid="post-category">{post.category}</span>
        <time class="date" datetime={post.publishedAt ?? post.createdAt} data-testid="post-date">
          {publishedDate}
        </time>
      </div>
      <h1 class="post-title" data-testid="article-title">{post.title}</h1>
      {post.tags && post.tags.length > 0 && (
        <div class="tags" data-testid="post-tags">
          {post.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    {/* Hero Image (if available) */}
    {firstImage && (
      <div class="hero-image">
        <img src={firstImage} alt={post.title} loading="eager" />
      </div>
    )}

    {/* Article Content - Sanitized HTML */}
    <div class="post-content" data-testid="article-content" set:html={post.contentHtml} />

    {/* Article Images Gallery (if multiple images) */}
    {images.length > 1 && (
      <div class="image-gallery">
        {images.slice(1).map((imageUrl, index) => (
          <img src={imageUrl} alt={`${post.title} - Image ${index + 2}`} loading="lazy" />
        ))}
      </div>
    )}

    {/* Back to Home Link */}
    <nav class="post-navigation">
      <a href="/" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="M12 19l-7-7 7-7"></path>
        </svg>
        Back
      </a>
    </nav>
  </article>
</Layout>

<style>
  .post-detail {
    max-width: 880px;
    margin: 0 auto;
    padding: 96px 40px 120px;
  }

  .post-header {
    position: relative;
    margin-bottom: 46px;
    padding-top: 26px;
  }

  .post-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 56px;
    height: 3px;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .post-meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 24px;
    font-family: var(--font-display);
  }

  .category {
    background: var(--color-primary-soft);
    padding: 6px 14px;
    border-radius: 999px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .post-title {
    font-size: clamp(2.25rem, 5.6vw, 4.75rem);
    font-weight: 600;
    color: var(--color-text-heading);
    line-height: 1.14;
    margin: 0 0 24px;
    letter-spacing: -0.055em;
    font-family: var(--font-display);
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-surface);
    padding: 4px 12px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-weight: 500;
    border: 1px solid var(--color-border);
  }

  .hero-image {
    margin-bottom: 52px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-content {
    font-size: 1.05rem;
    line-height: 2;
    color: var(--color-text);
  }

  /* Content HTML Styles */
  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    color: var(--color-text-heading);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
    line-height: 1.35;
    font-family: var(--font-display);
    letter-spacing: -0.035em;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .post-content :global(a:hover) {
    color: var(--color-link-hover);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.5rem 0 0.5rem 1.5rem;
    margin: 2rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-content :global(code) {
    background: var(--color-code-bg);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'Fira Code', 'Consolas', monospace;
  }

  .post-content :global(pre) {
    background: var(--color-code-pre-bg);
    color: var(--color-code-pre-text);
    padding: 1rem 1.5rem;
    border-radius: 16px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 0.875rem;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 18px;
    margin: 2rem 0;
  }

  .post-content :global(strong) {
    font-weight: 600;
    color: var(--color-text-heading);
  }

  .post-content :global(em) {
    font-style: italic;
  }

  .image-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .image-gallery img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
  }

  .post-navigation {
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .post-detail {
      padding: 64px 20px 88px;
    }

    .post-title {
      font-size: 2.35rem;
    }

    .post-content {
      font-size: 1rem;
    }
  }
</style>
