---
/**
 * about.astro - Aboutページ
 *
 * Task 2.4: Aboutページと404ページ実装
 *
 * Requirements:
 * - 2.4: Aboutページを静的に生成
 *   - Aboutページ (`about.astro`) を静的に生成
 *   - ビルド時に `/about/index.html` として静的生成
 * - 14.1, 14.2: 日本語対応
 */
import Layout from '../layouts/Layout.astro';
import { getAboutPageContent, getSiteMetadata } from '../lib/staticPageUtils';

const aboutContent = getAboutPageContent();
const siteMetadata = getSiteMetadata();
---

<Layout title={aboutContent.title} description={aboutContent.description}>
  <main class="about-journal" id="main-content">
    <header class="about-header">
      <h1 id="about-title">{aboutContent.title}</h1>
      <p class="about-caption">Story, profile &amp; connections</p>
    </header>

    <div class="about-layout">
      <div class="about-story">
        {
          aboutContent.sections.map((section, index) => (
            <section
              class="about-section"
              aria-labelledby={`about-section-${index}`}
            >
              <h2 class="section-title" id={`about-section-${index}`}>
                {section.heading}
              </h2>
              <div class="section-content">
                {section.content
                  .split('\n\n')
                  .map((paragraph, paragraphIndex) => (
                    <p
                      class:list={{ 'story-lead': paragraphIndex === 0 }}
                      set:html={paragraph.replace(/\n/g, '<br />')}
                    />
                  ))}
              </div>
            </section>
          ))
        }
      </div>

      <div class="about-details">
        <section
          class="about-section profile-section"
          aria-labelledby="profile-title"
        >
          <h2 class="section-title" id="profile-title">Profile</h2>
          <div class="profile-heading">
            <img
              src="/profile.png"
              alt={`${siteMetadata.author.name}のプロフィール画像`}
              class="avatar-image"
              width="88"
              height="88"
            />
            <div class="profile-identity">
              <h3 class="profile-name">{siteMetadata.author.name}</h3>
              {
                siteMetadata.author.role && (
                  <p class="profile-role">{siteMetadata.author.role}</p>
                )
              }
            </div>
          </div>
          {
            siteMetadata.author.bio && (
              <p class="profile-bio">{siteMetadata.author.bio}</p>
            )
          }
        </section>

        <section
          class="about-section connect-section"
          aria-labelledby="connect-title"
        >
          <h2 class="section-title" id="connect-title">Connect</h2>
          <ul class="social-links">
            {
              siteMetadata.socialLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                  >
                    <span>{link.name}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                    <span class="sr-only">（新しいタブで開く）</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    <nav class="navigation" aria-label="ホームへ">
      <a href="/" class="back-link">
        <span aria-hidden="true">←</span>
        ホームに戻る
      </a>
    </nav>
  </main>
</Layout>

<style>
  .about-journal {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px 96px;
  }
  .about-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--color-border);
  }
  .about-header h1 {
    margin: 0;
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    line-height: 1.2;
    letter-spacing: -0.045em;
  }
  .about-caption {
    margin: 0;
    color: var(--color-text);
    font-size: 0.9rem;
  }
  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    padding-top: 44px;
  }
  .about-story,
  .about-details {
    min-width: 0;
  }
  .about-details {
    padding-left: 32px;
    border-left: 1px solid var(--color-border);
  }
  .about-section + .about-section {
    margin-top: 40px;
  }
  .section-title {
    margin: 0 0 28px;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    line-height: 1.6;
  }
  .section-content p {
    margin: 0 0 24px;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 2.1;
    overflow-wrap: anywhere;
  }
  .section-content p:last-child {
    margin-bottom: 0;
  }
  .section-content .story-lead {
    max-width: 24ch;
    margin-bottom: 32px;
    color: var(--color-text-heading);
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    line-height: 1.65;
    text-wrap: balance;
  }
  .section-content :global(strong) {
    color: var(--color-primary);
    font-weight: 700;
  }
  .profile-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 24px;
  }
  .avatar-image {
    display: block;
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
  }
  .profile-identity {
    min-width: 0;
  }
  .profile-name {
    margin: 0 0 8px;
    font-size: 1.25rem;
    line-height: 1.5;
    letter-spacing: -0.025em;
  }
  .profile-role {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .profile-bio {
    margin: 0;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 2;
    overflow-wrap: anywhere;
  }
  .connect-section {
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }
  .connect-section .section-title {
    margin-bottom: 12px;
  }
  .social-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: 0.95rem;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }
  .social-link:hover {
    color: var(--color-link);
    text-decoration: underline;
  }
  .social-link svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }
  .navigation {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--color-link);
    font-family: var(--font-display);
    font-size: 0.9rem;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 767px) {
    .about-journal {
      padding: 0 20px 64px;
    }
    .about-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      padding: 36px 0 28px;
    }
    .about-caption {
      font-size: 0.8rem;
    }
    .about-layout {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-top: 28px;
    }
    .about-details {
      padding: 28px 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
    .section-title {
      margin-bottom: 20px;
    }
    .section-content p {
      font-size: 1rem;
    }
    .section-content .story-lead {
      font-size: 1.6rem;
      margin-bottom: 24px;
    }
    .navigation {
      margin-top: 36px;
    }
  }
</style>
