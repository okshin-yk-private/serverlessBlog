---
/**
 * about.astro - Aboutページ
 *
 * Task 2.4: Aboutページと404ページ実装
 *
 * Requirements:
 * - 2.4: Aboutページを静的に生成
 *   - Aboutページ (`about.astro`) を静的に生成
 *   - ビルド時に `/about/index.html` として静的生成
 * - 14.1, 14.2: 日本語対応
 */
import Layout from '../layouts/Layout.astro';
import { getAboutPageContent, getSiteMetadata } from '../lib/staticPageUtils';

const aboutContent = getAboutPageContent();
const siteMetadata = getSiteMetadata();
---

<Layout title={aboutContent.title} description={aboutContent.description}>
  <div class="about-page">
    <!-- Hero Section -->
    <section class="hero-section" aria-labelledby="about-title">
      <div class="hero-inner">
        <h1 id="about-title" class="hero-primary">{aboutContent.title}</h1>
        <p class="hero-secondary">Story, profile &amp; connections</p>
        <span class="hero-seed" aria-hidden="true"></span>
      </div>
    </section>

    <!-- Main Content -->
    <main class="content-container">
      <!-- About This Blog Section -->
      {aboutContent.sections.map((section) => (
        <section class="about-section">
          <h2 class="section-title">{section.heading}</h2>
          <div class="section-content">
            <p set:html={section.content.replace(/\n/g, '<br />')} />
          </div>
        </section>
      ))}

      <!-- Profile Section -->
      <section class="about-section">
        <h2 class="section-title">Profile</h2>
        <div class="profile-card">
          <div class="profile-avatar">
            <img src="/profile.png" alt="Profile" class="avatar-image" />
          </div>
          <div class="profile-info">
            <h3 class="profile-name">{siteMetadata.author.name}</h3>
            {siteMetadata.author.role && (
              <p class="profile-role">{siteMetadata.author.role}</p>
            )}
            {siteMetadata.author.bio && (
              <p class="profile-bio">{siteMetadata.author.bio}</p>
            )}
          </div>
        </div>
      </section>

      <!-- Social Links Section -->
      <section class="about-section">
        <h2 class="section-title">Connect</h2>
        <div class="social-links">
          {siteMetadata.socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              title={link.name}
            >
              {link.name === 'X' ? (
                <svg viewBox="0 0 24 24" fill="currentColor" class="social-icon">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="currentColor" class="social-icon">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
              )}
              <span class="social-name">{link.name}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Back to Home -->
      <nav class="navigation">
        <a href="/" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
          ホームに戻る
        </a>
      </nav>
    </main>
  </div>
</Layout>

<style>
  .about-page {
    min-height: 100vh;
    background: var(--color-bg);
  }

  .hero-section {
    position: relative;
    overflow: hidden;
    padding: 64px 32px;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-section::before,
  .hero-section::after {
    content: '';
    position: absolute;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    opacity: 0.52;
    pointer-events: none;
  }

  .hero-section::before {
    width: 500px;
    height: 500px;
    top: -330px;
    left: -110px;
  }

  .hero-section::after {
    width: 360px;
    height: 360px;
    right: -180px;
    bottom: -245px;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin: 0 auto;
  }

  .hero-primary {
    margin: 0 0 28px;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero-secondary {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }

  .hero-seed {
    display: block;
    width: 42px;
    height: 42px;
    margin: 34px auto 0;
    background: url('/favicon-light.png') center / contain no-repeat;
  }

  :global(:root[data-theme='dark']) .hero-seed {
    background-image: url('/favicon-dark.png');
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 88px 32px 112px;
  }

  .about-section {
    margin-bottom: 72px;
  }

  .about-section:last-of-type {
    margin-bottom: 0;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0 0 20px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-content {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 40px;
    box-shadow: var(--shadow-card);
  }

  .section-content p {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.8;
    margin: 0;
  }

  .section-content :global(strong) {
    color: var(--color-primary);
  }

  /* Profile Card */
  .profile-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 40px;
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .profile-avatar {
    flex-shrink: 0;
  }

  .avatar-image {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-primary-soft);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .profile-info {
    flex: 1;
  }

  .profile-name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 8px 0;
  }

  .profile-role {
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }

  .profile-bio {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.8;
    margin: 0;
  }

  /* Social Links */
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 16px 24px;
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-strong);
  }

  .social-icon {
    width: 24px;
    height: 24px;
  }

  .social-name {
    font-size: 0.95rem;
  }

  .navigation {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 48px 20px;
    }

    .hero-primary {
      margin-bottom: 24px;
      font-size: 0.62rem;
    }

    .hero-secondary {
      font-size: 0.62rem;
    }

    .hero-seed {
      width: 36px;
      height: 36px;
      margin-top: 30px;
    }

    .content-container {
      padding: 60px 20px 80px;
    }

    .profile-card {
      padding: 32px 24px;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .avatar-image {
      width: 100px;
      height: 100px;
    }

    .social-links {
      justify-content: center;
    }

    .social-link {
      padding: 12px 20px;
    }
  }
</style>
