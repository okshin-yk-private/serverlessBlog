{
  "name": "serverless-blog",
  "version": "1.0.0",
  "type": "module",
  "description": "AWS Serverless Blog System",
  "private": true,
  "scripts": {
    "verify": "bun run lint && bun run format:check && bun run typecheck && bun run test:unit && bun run test:go",
    "typecheck": "bun run typecheck:admin && bun run typecheck:astro",
    "typecheck:admin": "cd frontend/admin && bun run type-check",
    "typecheck:astro": "cd frontend/public-astro && bun run check",
    "test:unit": "bun run test:unit:admin && bun run test:unit:astro && bun run test:unit:deploy && bun run test:unit:config",
    "test:unit:admin": "cd frontend/admin && bunx vitest run",
    "test:unit:astro": "cd frontend/public-astro && bunx vitest run",
    "test:unit:deploy": "cd scripts/deploy && bunx vitest run",
    "test:unit:config": "bun test tests/config/",
    "test:go": "cd go-functions && make test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "HEADLESS=false playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "test:e2e:admin:ui": "playwright test --config=playwright.admin.config.ts --ui",
    "test:e2e:admin:headed": "HEADLESS=false playwright test --config=playwright.admin.config.ts",
    "test:e2e:admin:debug": "playwright test --config=playwright.admin.config.ts --debug",
    "test:e2e:admin:report": "playwright show-report playwright-report-admin",
    "test:e2e:all": "bun run test:e2e && bun run test:e2e:admin",
    "test:e2e:heal": "playwright test --reporter=json 2>test-results/heal-report.json || echo 'Tests failed. Invoke healer agent: /playwright-test-healer'",
    "test:e2e:aws": "VITE_ENABLE_MSW_MOCK=false playwright test --config=playwright.aws.config.ts --project=chromium",
    "test:e2e:aws:public": "VITE_ENABLE_MSW_MOCK=false playwright test --config=playwright.aws.config.ts --project=chromium tests/e2e/specs/home.spec.ts tests/e2e/specs/article.spec.ts",
    "test:e2e:aws:admin": "VITE_ENABLE_MSW_MOCK=false playwright test --config=playwright.aws.config.ts --project=admin-chromium",
    "cleanup:test-data": "node scripts/cleanup-test-data.js",
    "coverage:badges": "node scripts/generate-coverage-badges.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:frontend": "cd frontend/admin && eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@aws-lambda-powertools/tracer": "^2.35.0",
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-dynamodb": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0"
  },
  "overrides": {
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^20.19.43",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "uuid": "^13.0.2"
  }
}
